          "desc": "[推送全文] 会被自动替换. 形如 https://api2.pushdeer.com/message/push?pushkey=XXXXXXXXXXX&text=[推送全文]"
        },
        {
          "id": "@ChinaTelecomOperators.sms_forward.telegram",
          "name": "转发到 Telegram 等",
          "val": "",
          "type": "textarea",
          "desc": "[推送全文] 会被自动替换. 形如 https://api.telegram.org/botXXXXXXXXXX/sendmessage?text=[推送全文]&chat_id=XXXXXXXXX"
        },
        {
          "id": "@ChinaTelecomOperators.sms_forward.pushover",
          "name": "转发到 Pushover 等",
          "val": "",
          "type": "textarea",
          "desc": "[推送全文] 会被自动替换. 形如https://api.pushover.net/1/messages.json?token=APP_TOKEN&user=USER_KEY"
        },
