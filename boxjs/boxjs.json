          "id": "@ChinaTelecomOperators.sms_forward.subtitle",
          "name": "通知副标题模板",
          "val": "",
          "type": "text",
          "desc": "默认: [码][复制提示], 例: 123456(长按/下拉复制验证码)"
        },
